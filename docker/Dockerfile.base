FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    python3 \
    python3-dev \
    python3-pip \
    pkg-config \
    wget \
    curl \
    uuid-dev \
    libjsoncpp-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*
